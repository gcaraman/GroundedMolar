<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Surface.Window" Color="#16060E"/><SolidColorBrush x:Key="Surface.Panel" Color="#3A1B25"/><SolidColorBrush x:Key="Surface.PanelStrong" Color="#552B35"/><SolidColorBrush x:Key="Surface.Map" Color="#11151B"/>
  <SolidColorBrush x:Key="Text.Primary" Color="#F7EFDD"/><SolidColorBrush x:Key="Text.Secondary" Color="#D9C2B5"/><SolidColorBrush x:Key="Text.Heading" Color="#FBD688"/>
  <SolidColorBrush x:Key="Accent.Primary" Color="#C34A32"/><SolidColorBrush x:Key="Accent.PrimaryHover" Color="#E05B3D"/><SolidColorBrush x:Key="Accent.Selected" Color="#DB9400"/><SolidColorBrush x:Key="Border.Subtle" Color="#805967"/>
  <SolidColorBrush x:Key="Status.Success" Color="#8FCB82"/><SolidColorBrush x:Key="Status.Warning" Color="#FBD688"/><SolidColorBrush x:Key="Status.Error" Color="#FA6C5F"/><SolidColorBrush x:Key="Status.Unknown" Color="#C7B7D8"/>
  <FontFamily x:Key="Font.Body">Segoe UI</FontFamily><FontFamily x:Key="Font.Display">Bahnschrift SemiCondensed</FontFamily>
  <Style x:Key="GroundedWindow" TargetType="Window"><Setter Property="Background" Value="{DynamicResource Surface.Window}"/><Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/><Setter Property="FontFamily" Value="{DynamicResource Font.Body}"/><Setter Property="FontSize" Value="15"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>
  <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource Font.Display}"/><Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Text.Heading}"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource Font.Display}"/><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Text.Heading}"/></Style>
  <Style x:Key="SecondaryText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="PanelCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface.Panel}"/><Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="16"/></Style>
  <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource PanelCard}"><Setter Property="MinHeight" Value="64"/><Setter Property="Padding" Value="12,8"/><Setter Property="Background" Value="{DynamicResource Surface.PanelStrong}"/></Style>
</ResourceDictionary>
