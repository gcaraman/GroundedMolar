<Window x:Class="GroundedMolar.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Grounded Milk Molar Map" Width="1280" Height="820" MinWidth="900" MinHeight="680" Style="{StaticResource GroundedWindow}">
  <Grid>
    <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#280500" Offset="0"/><GradientStop Color="#16060E" Offset="0.58"/><GradientStop Color="#08070A" Offset="1"/></LinearGradientBrush></Grid.Background>
    <Grid Margin="28,22,28,26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource PageTitle}" Text="GROUNDED NG+ MILK MOLARS"/><Grid Grid.Column="1" Margin="24,20,0,0" Height="5"><Rectangle Fill="{DynamicResource Accent.Primary}"/><Path Stroke="{DynamicResource Text.Heading}" StrokeThickness="2" Data="M 24,0 L 19,5 M 54,0 L 49,5 M 84,0 L 79,5"/></Grid></Grid>
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource PanelCard}" Background="{DynamicResource Surface.PanelStrong}" BorderBrush="{DynamicResource Accent.Primary}" BorderThickness="2">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
          <Border Width="164" Height="90" Background="{DynamicResource Surface.Window}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="2" ClipToBounds="True"><Grid><Image x:Name="SaveScreenshotPreview" Stretch="Fill"/><TextBlock x:Name="SaveScreenshotPlaceholder" Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="No preview"/></Grid></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="CurrentSaveName" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text.Heading}" Text="NO SAVE SELECTED" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="CurrentSaveLocation" Margin="0,5,0,0" Style="{StaticResource SecondaryText}" Text="Choose a save to get started." TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="CurrentSaveModified" Margin="0,7,0,0" Foreground="{DynamicResource Text.Primary}" FontSize="13" Text="—" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="CurrentSaveSummary" Margin="0,5,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Status.Unknown}" Text="No save loaded" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
          <Button x:Name="RefreshButton" Grid.Column="2" Width="104" Height="44" MinHeight="0" Margin="16,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource PrimaryButton}" Content="Refresh" IsDefault="True" IsEnabled="False" Click="LoadClick"/>
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
        <TextBox x:Name="SavePathBox" Visibility="Collapsed" IsReadOnly="True"/>
        <Button Style="{StaticResource SecondaryButton}" Content="Choose save…" AutomationProperties.Name="Choose save file" Click="BrowseClick"/>
        <Button Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" Content="Choose saves folder…" AutomationProperties.Name="Choose saves folder" Click="BrowseFolderClick"/>
      </StackPanel>
    </Grid>
    <Grid x:Name="WorkspaceGrid" Grid.Row="2" Margin="0,16,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
      <Border x:Name="MapFrame" Grid.RowSpan="2" BorderBrush="{DynamicResource Accent.Primary}" BorderThickness="2" Background="{DynamicResource Surface.Map}"><Grid>
        <ScrollViewer x:Name="MapScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" PreviewMouseWheel="MapMouseWheel" SizeChanged="MapViewportSizeChanged" PreviewMouseLeftButtonDown="MapMouseDown" PreviewMouseLeftButtonUp="MapMouseUp" PreviewMouseMove="MapMouseMove" MouseLeave="MapMouseLeave"><Canvas x:Name="ViewportSurface" HorizontalAlignment="Left" VerticalAlignment="Top"><Canvas x:Name="MapSurface" ClipToBounds="False"><Image x:Name="MapPreview" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Canvas></Canvas></ScrollViewer>
        <Border Panel.ZIndex="3" Margin="14" Padding="6" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Accent.Primary}" BorderThickness="2"><StackPanel Orientation="Horizontal"><Button Width="44" Height="42" MinWidth="0" MinHeight="0" Style="{StaticResource CompactButton}" Content="−" ToolTip="Zoom out" AutomationProperties.Name="Zoom out" Click="ZoomOutClick"/><Button Width="44" Height="42" MinWidth="0" MinHeight="0" Margin="4,0,0,0" Style="{StaticResource CompactButton}" Content="+" ToolTip="Zoom in" AutomationProperties.Name="Zoom in" Click="ZoomInClick"/><Button Width="62" Height="42" MinWidth="0" MinHeight="0" Margin="4,0,0,0" Style="{StaticResource CompactButton}" Content="FIT" ToolTip="Fit the whole map" Click="FitClick"/><TextBlock x:Name="ZoomText" MinWidth="52" Margin="10,0,4,0" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Display}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Text.Heading}" Text="Fit"/></StackPanel></Border>
        <Border x:Name="PreviewOverlay" MaxWidth="480" Padding="24" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="3" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text.Heading}" Text="MAP PREVIEW" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewPlaceholder" Margin="0,8,0,0" Foreground="{DynamicResource Text.Primary}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Text="Choose a World.csav or saves folder to load a map."/></StackPanel></Border>
      </Grid></Border>
      <ScrollViewer x:Name="PreferencesPanel" Grid.Column="1" Grid.RowSpan="2" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Preferences"><StackPanel><Border Background="{DynamicResource Accent.Primary}" Padding="12,7"><TextBlock FontFamily="{DynamicResource Font.Display}" FontWeight="SemiBold" FontSize="19" Text="PREFERENCES"/></Border>
        <Border Margin="0,8,0,0" Style="{StaticResource SettingRow}"><StackPanel><CheckBox x:Name="MonitorFolderCheckBox" Checked="MonitorFolderChanged" Unchecked="MonitorFolderChanged"><TextBlock Text="Monitor folder automatically" TextWrapping="Wrap"/></CheckBox><TextBlock x:Name="MonitorStatusText" Margin="4,2,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Margin="0,8,0,0" Style="{StaticResource SettingRow}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Unapproached markers"/><TextBlock x:Name="UnapproachedOpacityText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Text.Heading}"/></Grid><Slider x:Name="UnapproachedOpacitySlider" Margin="0,8,0,0" Minimum="0" Maximum="1" TickFrequency="0.05" SmallChange="0.05" LargeChange="0.1" IsSnapToTickEnabled="True" AutomationProperties.Name="Unapproached marker opacity" ValueChanged="UnapproachedOpacityChanged"/><TextBlock Margin="0,3,0,0" Style="{StaticResource SecondaryText}" Text="Opacity for molars not yet approached" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Margin="0,8,0,0" Style="{StaticResource SettingRow}"><StackPanel><CheckBox x:Name="ShowGuideHintsCheckBox" Checked="GuideHintsChanged" Unchecked="GuideHintsChanged"><TextBlock Text="Show community guide hints" TextWrapping="Wrap"/></CheckBox><TextBlock Margin="4,2,0,0" Style="{StaticResource SecondaryText}" Text="Adds approximate community location text to every Milk Molar popup." TextWrapping="Wrap"/><TextBlock Margin="4,8,0,2" TextWrapping="Wrap"><Hyperlink Foreground="{DynamicResource Text.Heading}" Click="GuideLinkClick">View the community guide</Hyperlink></TextBlock></StackPanel></Border>
      </StackPanel></ScrollViewer>
    </Grid>
    </Grid>
  </Grid>
</Window>
